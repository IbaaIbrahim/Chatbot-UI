VITE_API_BASE_URL=http://localhost:8001
VITE_STORAGE_API_BASE_URL=http://localhost:8003
VITE_ACCESS_TOKEN=
# VITE_MODEL_ID=gpt-5-mini

# Opt in to calling a loopback / private-network API (the localhost defaults
# above, a LAN IP, a *.local host). Chromium 142+ treats that as Local Network
# Access and asks the user for permission — on Android the prompt reads
# "Access other apps and services on this device".
#
# This flag only annotates the requests with targetAddressSpace so an https:
# page can reach that prompt instead of being stopped by the mixed-content
# check. It does NOT grant the permission:
#   * the user still has to allow it, and
#   * when this UI is embedded in an iframe, EVERY parent frame must delegate it
#     with allow="local-network-access; loopback-network; local-network"
#     (Chromium renamed the token in 145; listing all three is safe).
#
# In production, point VITE_API_BASE_URL / VITE_STORAGE_API_BASE_URL at public
# HTTPS origins and leave this unset — then no permission is involved at all.
# VITE_ALLOW_LOCAL_NETWORK_ACCESS=true

# Extra hostnames the Vite dev server accepts, comma-separated.
# localhost and 127.0.0.1 are always allowed.
# DEV_ALLOWED_HOSTS=
